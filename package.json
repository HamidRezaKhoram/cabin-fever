{
  "name": "rumpus",
  "version": "0.3.0",
  "description": "Self-hosted Jackbox-style party game platform: shared TV screen + phone controllers on your LAN.",
  "license": "AGPL-3.0-only",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/unit/",
    "test:all": "./scripts/test-all.sh",
    "build:content": "python3 tools/build-content.py",
    "build:icons": "python3 tools/make-icons.py",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.host.json && tsc -p tsconfig.play.json && tsc -p tsconfig.web.json",
    "lint": "eslint --max-warnings=0 .",
    "coverage": "c8 node --test --test-concurrency=4 test/unit/",
    "build:pages": "node tools/build-pages.js",
    "fetch:voice": "node tools/fetch-kokoro.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "@types/qrcode": "1.5.5",
    "c8": "10.1.2",
    "esbuild": "0.24.0",
    "eslint": "9.14.0",
    "globals": "15.12.0",
    "kokoro-js": "1.2.1",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "peerjs": "1.5.4",
    "socket.io-client": "^4.7.5",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0"
  }
}
