{
  "name": "rumpus",
  "version": "0.3.0",
  "description": "Self-hosted Jackbox-style party game platform: shared TV screen + phone controllers on your LAN.",
  "license": "AGPL-3.0-only",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/unit/ && node test/e2e-new.js",
    "test:all": "./scripts/test-all.sh",
    "build:content": "python3 tools/build-content.py",
    "build:icons": "python3 tools/make-icons.py",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.host.json && tsc -p tsconfig.play.json"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.7.5",
    "typescript": "5.6.3",
    "@types/node": "20.17.6"
  }
}
