#!/usr/bin/env bash
# Pre-commit: types must be correct and lint clean before anything is committed.
# (Enabled per clone with: git config core.hooksPath .githooks — scripts/test-all.sh does it.)
# Node isn't on the host, so this runs in the same container the tests use.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
source test/kit/containers.sh
echo "pre-commit: type check + lint + strict ratchet…"
in_node cabin-fever 'npm run -s typecheck && npm run -s lint && node tools/strict-ratchet.js >/dev/null' \
  || { echo "pre-commit: FAILED — fix the type/lint errors above (or run ./scripts/test-all.sh)"; exit 1; }
echo "pre-commit: ok"
